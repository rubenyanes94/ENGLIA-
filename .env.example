# Copia este archivo a ".env" (sin el ".example") y ajusta valores si lo necesitas.
# En desarrollo local con Docker Compose los valores por defecto ya funcionan.

# --- PostgreSQL ---
POSTGRES_USER=englia
POSTGRES_PASSWORD=englia_dev_password
POSTGRES_DB=englia

# Cadena de conexión que usará SQLAlchemy (async) desde el backend.
# "db" es el nombre del servicio de Postgres dentro de docker-compose.yml,
# no "localhost", porque los contenedores se hablan entre sí por nombre de servicio.
DATABASE_URL=postgresql+asyncpg://englia:englia_dev_password@db:5432/englia

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Seguridad (cámbialo antes de producción) ---
SECRET_KEY=change_me_in_production

ENVIRONMENT=development

# --- LLM (dev: Ollama; producción: vLLM/NVIDIA NIM) ---
# Modelo que se descarga en el contenedor "ollama" la primera vez.
# llama3.2:1b es deliberadamente pequeño (~1.3GB) para caber en un
# Codespace estándar de 8GB de RAM junto con VS Code y el resto de
# servicios. Si tu máquina tiene más RAM (16GB+), prueba llama3.2:3b
# para mejor calidad de respuesta.
LLM_MODEL=llama3.2:1b

# --- Facturación ---
# Todo vacío por defecto: cada pasarela (app/billing/*.py) comprueba si
# tiene credenciales antes de intentar cobrar, y devuelve un 503
# explicable en vez de fallar oscuro si falta configurar algo.
FRONTEND_BASE_URL=http://localhost:5173

# Stripe (tarjetas: Mastercard/Visa/Amex)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (Subscriptions API — requiere un Product+Plan creado de
# antemano del lado de PayPal; ver el aviso en app/billing/paypal.py)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Binance Pay (cripto)
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
BINANCE_PAY_API_BASE=https://bpay.binanceapi.com

# --- Voz del tutor ---
# "magpie" (NVIDIA por API: Diego dice el español Y el inglés, que es la
# voz elegida para el producto) o "piper" (local y sin clave, pero con
# una voz distinta por idioma — el alumno oye cambiar de profesor).
TTS_PROVIDER=magpie

# Clave de build.nvidia.com. Necesaria solo si TTS_PROVIDER=magpie.
# Se saca sin tarjeta en https://build.nvidia.com — NUNCA la subas al repo.
NVIDIA_API_KEY=

# --- Tutor (LLM) ---
# Endpoint de CHAT. Por defecto el catálogo de NVIDIA (compatible con la
# API de OpenAI). Para trabajar sin conexión: http://ollama:11434/v1 y un
# modelo local en LLM_MODEL.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_API_KEY=

# Endpoint de EMBEDDINGS. Sigue siendo una variable aparte de la del chat
# aunque hoy apunten al mismo sitio: son dos motores que deben poder
# moverse por separado (hizo falta justo al migrar el chat primero).
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_API_KEY=

# --- Datos de la academia para Pago Móvil ---
# A estos datos transfiere dinero REAL un alumno. Vacíos por defecto a
# propósito: sin ellos el frontend dice que el método no está disponible,
# en vez de mostrar una cuenta de ejemplo a la que alguien acabaría
# transfiriendo de verdad.
PAGO_MOVIL_BANK=
PAGO_MOVIL_DOCUMENT=
PAGO_MOVIL_PHONE=
