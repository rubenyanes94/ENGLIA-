{
  "name": "English Academy Dev",

  // Se ejecuta en el HOST (la VM del Codespace), ANTES de crear los
  // contenedores. Crea .env a partir de .env.example la primera vez, ya
  // que .env está en .gitignore y por tanto no existe en un Codespace
  // recién creado. El `|| true` final es deliberado: si esto fallara,
  // Codespaces abortaría la creación del contenedor y caería en "modo
  // recuperación" — justo lo que queremos evitar. El stack ya arranca sin
  // .env (ver "required: false" en el docker-compose.yml de la raíz);
  // esto solo te deja el archivo listo para editar tus credenciales.
  "initializeCommand": "cp -n .env.example .env 2>/dev/null || true",

  // Codespaces lee estos DOS archivos y los combina: el docker-compose.yml
  // de la raíz (el "real", el que también usarías en un servidor) más este
  // de aquí al lado (docker-compose.yml de .devcontainer), que solo AÑADE
  // ajustes específicos para el editor.
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],

  // A qué contenedor se "conecta" la ventana de VS Code / Codespaces.
  "service": "backend",

  // Qué contenedores se arrancan aunque VS Code solo se conecte a "backend".
  "runServices": ["db", "redis", "ollama", "backend", "celery_worker", "frontend"],

  // Carpeta que verás abierta en el explorador de archivos (todo el repo).
  // OJO con las mayúsculas: tiene que coincidir EXACTO con el nombre real
  // de la carpeta del repo ("ENGLIA-"), porque Linux distingue mayúsculas
  // de minúsculas. Con "englia-" en minúscula, Codespaces monta una ruta
  // vacía que no es tu repo — el "docker-compose.yml" de este mismo
  // directorio también usa "ENGLIA-" en su volumen, deben ir siempre a la par.
  "workspaceFolder": "/workspaces/ENGLIA-",

  // Al cerrar Codespaces, apaga también los contenedores (no los deja huérfanos).
  "shutdownAction": "stopCompose",

  // Se ejecuta DENTRO del contenedor "backend" cada vez que arranca (creación
  // inicial y también cada vez que reabres/reanudas el Codespace). Antes
  // tenías que acordarte de lanzar `uvicorn` a mano en la terminal cada vez;
  // ahora start-backend.sh lo hace por ti en segundo plano (y no duplica el
  // proceso si ya estaba corriendo). Logs en /tmp/uvicorn.log dentro del
  // contenedor si necesitas revisarlos.
  "postStartCommand": "bash /workspaces/ENGLIA-/.devcontainer/start-backend.sh",

  // Docker-outside-of-Docker: instala el CLI de `docker` (con el plugin
  // `compose`) DENTRO del contenedor "backend" y lo conecta al Docker del
  // HOST del Codespace vía el socket montado en docker-compose.yml de aquí
  // al lado. Sin esto, esta terminal no puede levantar/parar/reconstruir
  // los demás servicios (ej. "celery_worker") con `docker compose ...`.
  "features": {
    // "moby: false" fuerza a instalar el CLI oficial de Docker (docker-ce-cli)
    // en vez de la variante "moby", que ya no tiene paquetes disponibles en
    // Debian "trixie" (la base de python:3.12-slim) y hacía fallar el build
    // del contenedor "backend" por completo.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },

  "forwardPorts": [8000, 5173, 5432, 6379, 11434],
  "portsAttributes": {
    "8000": { "label": "FastAPI Backend", "onAutoForward": "notify" },
    "5173": { "label": "React Frontend", "onAutoForward": "openPreview" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" },
    "6379": { "label": "Redis", "onAutoForward": "silent" },
    "11434": { "label": "Ollama (LLM)", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },

  "remoteUser": "root"
}
